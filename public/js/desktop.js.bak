const config = window.WT_CONFIG || {};
const desktop = document.querySelector('.desktop');
const workspace = document.querySelector('.desktop-workspace');
const iconHost = document.querySelector('#desktopIcons');
const taskbar = document.querySelector('.taskbar');

const TASKBAR_HEIGHT = 29;
const WINDOW_MARGIN = 8;
const ICON_SAFE_WIDTH = 86;
let topZ = 20;
let uiScale = 1;
const windowStates = new Map();

function maybeResetSavedLayout() {
  const params = new URLSearchParams(location.search);
  if (params.get('resetLayout') !== '1') return;
  for (let i = localStorage.length - 1; i >= 0; i -= 1) {
    const key = localStorage.key(i);
    if (key?.startsWith('watchTogether.window.') || key?.startsWith('watchTogether.desktopIcon.')) {
      localStorage.removeItem(key);
    }
  }
  params.delete('resetLayout');
  const query = params.toString();
  history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
}

function clamp(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

function readJson(key) {
  try {
    const raw = localStorage.getItem(key);
    return raw ? JSON.parse(raw) : null;
  } catch {
    return null;
  }
}

function writeJson(key, value) {
  try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* storage can be blocked */ }
}

function installConfiguredFonts() {
  const fonts = config.fonts || {};
  if (!fonts.latinRegularUrl) return;
  const q = (value) => String(value).replace(/[\\"\n\r]/g, (char) => `\\${char}`);
  const style = document.createElement('style');
  style.id = 'wt-configured-fonts';
  style.textContent = `
    @font-face {
      font-family: "WT MS Sans Pixel";
      src: url("${q(fonts.latinRegularUrl)}") format("woff");
      font-weight: 400;
      font-style: normal;
      font-display: block;
    }
    @font-face {
      font-family: "WT MS Sans Pixel";
      src: url("${q(fonts.latinBoldUrl || fonts.latinRegularUrl)}") format("woff");
      font-weight: 700;
      font-style: normal;
      font-display: block;
    }
  `;
  document.head.append(style);
}

function resolveUiScale() {
  const setting = config.display?.uiScale ?? 'auto';
  if (Number.isFinite(Number(setting)) && Number(setting) >= 1) {
    return clamp(Math.round(Number(setting)), 1, 4);
  }

  // Chromium reports the viewport in CSS pixels. On a 4K Windows display at
  // 150%/200% scaling, innerWidth can look like a much smaller monitor.
  // Recover an approximate physical-pixel viewport with devicePixelRatio,
  // then require both a usable CSS viewport and a genuinely HiDPI surface.
  const dpr = Math.max(1, window.devicePixelRatio || 1);
  const viewportW = window.innerWidth;
  const viewportH = window.innerHeight;
  const physicalW = viewportW * dpr;
  const physicalH = viewportH * dpr;
  const minViewportW = config.display?.autoScale2MinViewportWidth ?? 1500;
  const minViewportH = config.display?.autoScale2MinViewportHeight ?? 820;
  const minPhysicalW = config.display?.autoScale2MinPhysicalWidth ?? 3200;
  const minPhysicalH = config.display?.autoScale2MinPhysicalHeight ?? 1800;

  const enoughRoom = viewportW >= minViewportW && viewportH >= minViewportH;
  const isHiDpi4kClass = physicalW >= minPhysicalW && physicalH >= minPhysicalH;
  return enoughRoom && isHiDpi4kClass ? 2 : 1;
}

function desktopBounds() {
  const width = Number.parseFloat(desktop?.style.width) || window.innerWidth / uiScale;
  const height = Number.parseFloat(desktop?.style.height) || window.innerHeight / uiScale;
  return { width, height, workHeight: Math.max(200, height - TASKBAR_HEIGHT) };
}

function clientToDesktop(clientX, clientY) {
  const rect = desktop.getBoundingClientRect();
  return {
    x: (clientX - rect.left) / uiScale,
    y: (clientY - rect.top) / uiScale,
  };
}

function applyDesktopScale() {
  uiScale = resolveUiScale();
  window.__WT_UI_SCALE = uiScale;
  document.documentElement.style.setProperty('--ui-scale', String(uiScale));
  const logicalWidth = Math.max(320, Math.floor(window.innerWidth / uiScale));
  const logicalHeight = Math.max(240, Math.floor(window.innerHeight / uiScale));
  desktop.style.width = `${logicalWidth}px`;
  desktop.style.height = `${logicalHeight}px`;
  desktop.style.transform = `scale(${uiScale})`;
  desktop.style.transformOrigin = '0 0';
}

function defaultWindowRects() {
  const { width, workHeight } = desktopBounds();
  const usableLeft = width >= 880 ? ICON_SAFE_WIDTH : WINDOW_MARGIN;
  const usableWidth = Math.max(620, width - usableLeft - WINDOW_MARGIN);
  const gap = 8;
  const chatCfg = config.windows?.chat || {};
  const mediaCfg = config.windows?.media || {};
  const minChat = chatCfg.minWidth ?? 330;
  const minMedia = mediaCfg.minWidth ?? 560;
  let chatWidth = Math.max(minChat, Math.round(usableWidth * (chatCfg.widthRatio ?? 0.34)));
  let mediaWidth = usableWidth - gap - chatWidth;
  if (mediaWidth < minMedia) {
    mediaWidth = minMedia;
    chatWidth = Math.max(minChat, usableWidth - gap - mediaWidth);
  }
  if (mediaWidth + gap + chatWidth > usableWidth) {
    const overflow = mediaWidth + gap + chatWidth - usableWidth;
    mediaWidth = Math.max(420, mediaWidth - overflow);
  }
  const height = Math.max(390, workHeight - WINDOW_MARGIN * 2);
  return {
    media: { x: usableLeft, y: WINDOW_MARGIN, width: mediaWidth, height },
    chat: { x: usableLeft + mediaWidth + gap, y: WINDOW_MARGIN, width: chatWidth, height },
  };
}

function sanitizeRect(rect, state) {
  const { width: desktopWidth, workHeight } = desktopBounds();
  const minWidth = state.minWidth;
  const minHeight = state.minHeight;
  const width = clamp(Number(rect.width) || minWidth, Math.min(minWidth, desktopWidth), desktopWidth);
  const height = clamp(Number(rect.height) || minHeight, Math.min(minHeight, workHeight), workHeight);
  return {
    x: clamp(Number(rect.x) || 0, 0, Math.max(0, desktopWidth - width)),
    y: clamp(Number(rect.y) || 0, 0, Math.max(0, workHeight - height)),
    width,
    height,
  };
}

function applyRect(state, rect) {
  const clean = sanitizeRect(rect, state);
  state.rect = clean;
  Object.assign(state.element.style, {
    left: `${Math.round(clean.x)}px`,
    top: `${Math.round(clean.y)}px`,
    width: `${Math.round(clean.width)}px`,
    height: `${Math.round(clean.height)}px`,
  });
}

function saveWindowRect(state) {
  if (!config.display?.rememberWindowLayout || state.maximized) return;
  writeJson(`watchTogether.window.${state.id}`, state.rect);
}

function setActive(state) {
  if (!state || state.closed || state.minimized) return;
  for (const candidate of windowStates.values()) {
    const isActive = candidate === state;
    candidate.element.classList.toggle('window-active', isActive);
    candidate.element.querySelector('.title-bar')?.classList.toggle('inactive', !isActive);
    candidate.taskButton?.classList.toggle('active', isActive && !candidate.minimized);
  }
  state.element.style.zIndex = String(++topZ);
}

function openWindow(id) {
  const state = windowStates.get(id);
  if (!state) return;
  state.closed = false;
  state.minimized = false;
  state.element.hidden = false;
  if (state.taskButton) state.taskButton.hidden = false;
  if (state.maximized) maximizeWindow(state, true);
  setActive(state);
}

function minimizeWindow(state) {
  if (!state || state.closed) return;
  state.minimized = true;
  state.element.hidden = true;
  state.taskButton?.classList.remove('active');
  const next = [...windowStates.values()].reverse().find((candidate) => !candidate.closed && !candidate.minimized && candidate !== state);
  if (next) setActive(next);
}

function closeWindow(state) {
  if (!state) return;
  state.closed = true;
  state.minimized = false;
  state.element.hidden = true;
  if (state.taskButton) state.taskButton.hidden = true;
  const next = [...windowStates.values()].reverse().find((candidate) => !candidate.closed && !candidate.minimized && candidate !== state);
  if (next) setActive(next);
}

function restoreWindow(state) {
  if (!state) return;
  if (state.minimized || state.closed) {
    state.minimized = false;
    state.closed = false;
    state.element.hidden = false;
    if (state.taskButton) state.taskButton.hidden = false;
  }
  if (state.maximized) {
    state.maximized = false;
    state.element.classList.remove('is-maximized');
    state.maxButton?.setAttribute('aria-label', 'Maximize');
    state.maxButton?.setAttribute('title', 'Maximize');
    applyRect(state, state.restoreRect || state.rect);
  }
  setActive(state);
}

function maximizeWindow(state, keepRestore = false) {
  if (!state) return;
  if (state.maximized && !keepRestore) {
    restoreWindow(state);
    return;
  }
  if (!keepRestore) state.restoreRect = { ...state.rect };
  state.maximized = true;
  state.minimized = false;
  state.closed = false;
  state.element.hidden = false;
  if (state.taskButton) state.taskButton.hidden = false;
  const { width, workHeight } = desktopBounds();
  state.element.classList.add('is-maximized');
  state.maxButton?.setAttribute('aria-label', 'Restore');
  state.maxButton?.setAttribute('title', 'Restore');
  applyRect(state, { x: 0, y: 0, width, height: workHeight });
  setActive(state);
}

function startWindowDrag(event, state) {
  if (event.button !== 0 || state.maximized || event.target.closest('[data-window-action]')) return;
  setActive(state);
  const titleBar = event.currentTarget;
  titleBar.setPointerCapture(event.pointerId);
  const start = clientToDesktop(event.clientX, event.clientY);
  const original = { ...state.rect };
  document.body.classList.add('window-operation');

  const move = (moveEvent) => {
    if (moveEvent.pointerId !== event.pointerId) return;
    const point = clientToDesktop(moveEvent.clientX, moveEvent.clientY);
    const { width, workHeight } = desktopBounds();
    const x = clamp(original.x + point.x - start.x, 0, Math.max(0, width - original.width));
    const y = clamp(original.y + point.y - start.y, 0, Math.max(0, workHeight - original.height));
    applyRect(state, { ...original, x, y });
  };
  const end = (endEvent) => {
    if (endEvent.pointerId !== event.pointerId) return;
    titleBar.removeEventListener('pointermove', move);
    titleBar.removeEventListener('pointerup', end);
    titleBar.removeEventListener('pointercancel', end);
    document.body.classList.remove('window-operation');
    saveWindowRect(state);
  };
  titleBar.addEventListener('pointermove', move);
  titleBar.addEventListener('pointerup', end);
  titleBar.addEventListener('pointercancel', end);
  event.preventDefault();
}

function resizeFromDirection(state, direction, startRect, dx, dy) {
  const { width: deskWidth, workHeight } = desktopBounds();
  let { x, y, width, height } = startRect;
  if (direction.includes('e')) width += dx;
  if (direction.includes('s')) height += dy;
  if (direction.includes('w')) { x += dx; width -= dx; }
  if (direction.includes('n')) { y += dy; height -= dy; }

  if (width < state.minWidth) {
    if (direction.includes('w')) x -= state.minWidth - width;
    width = state.minWidth;
  }
  if (height < state.minHeight) {
    if (direction.includes('n')) y -= state.minHeight - height;
    height = state.minHeight;
  }

  if (x < 0) { if (direction.includes('w')) width += x; x = 0; }
  if (y < 0) { if (direction.includes('n')) height += y; y = 0; }
  width = Math.min(width, deskWidth - x);
  height = Math.min(height, workHeight - y);
  return { x, y, width, height };
}

function startResize(event, state, direction) {
  if (event.button !== 0 || state.maximized) return;
  setActive(state);
  const handle = event.currentTarget;
  handle.setPointerCapture(event.pointerId);
  const start = clientToDesktop(event.clientX, event.clientY);
  const original = { ...state.rect };
  document.body.classList.add('window-operation');

  const move = (moveEvent) => {
    if (moveEvent.pointerId !== event.pointerId) return;
    const point = clientToDesktop(moveEvent.clientX, moveEvent.clientY);
    const rect = resizeFromDirection(state, direction, original, point.x - start.x, point.y - start.y);
    applyRect(state, rect);
  };
  const end = (endEvent) => {
    if (endEvent.pointerId !== event.pointerId) return;
    handle.removeEventListener('pointermove', move);
    handle.removeEventListener('pointerup', end);
    handle.removeEventListener('pointercancel', end);
    document.body.classList.remove('window-operation');
    saveWindowRect(state);
  };
  handle.addEventListener('pointermove', move);
  handle.addEventListener('pointerup', end);
  handle.addEventListener('pointercancel', end);
  event.preventDefault();
  event.stopPropagation();
}

function addResizeHandles(state) {
  for (const direction of ['n', 'ne', 'e', 'se', 's', 'sw', 'w', 'nw']) {
    const handle = document.createElement('div');
    handle.className = `window-resize-handle resize-${direction}`;
    handle.dataset.resize = direction;
    handle.addEventListener('pointerdown', (event) => startResize(event, state, direction));
    state.element.append(handle);
  }
}

function initWindows() {
  const defaults = defaultWindowRects();
  document.querySelectorAll('.desktop-window[data-window-id]').forEach((element) => {
    const id = element.dataset.windowId;
    const cfg = config.windows?.[id] || {};
    const stored = config.display?.rememberWindowLayout ? readJson(`watchTogether.window.${id}`) : null;
    const taskButton = document.querySelector(`[data-task-window="${id}"]`);
    const state = {
      id,
      element,
      taskButton,
      minWidth: cfg.minWidth ?? 320,
      minHeight: cfg.minHeight ?? 260,
      rect: defaults[id] || { x: 20, y: 20, width: 600, height: 500 },
      restoreRect: null,
      minimized: false,
      maximized: false,
      closed: false,
      maxButton: element.querySelector('[data-window-action="maximize"]'),
    };
    windowStates.set(id, state);
    applyRect(state, stored || defaults[id] || state.rect);
    addResizeHandles(state);

    const titleBar = element.querySelector('.title-bar');
    titleBar?.addEventListener('pointerdown', (event) => startWindowDrag(event, state));
    titleBar?.addEventListener('dblclick', (event) => {
      if (event.target.closest('[data-window-action]')) return;
      maximizeWindow(state);
    });
    element.addEventListener('pointerdown', () => setActive(state), true);

    element.querySelector('[data-window-action="minimize"]')?.addEventListener('click', (event) => {
      event.stopPropagation();
      minimizeWindow(state);
    });
    element.querySelector('[data-window-action="maximize"]')?.addEventListener('click', (event) => {
      event.stopPropagation();
      maximizeWindow(state);
    });
    element.querySelector('[data-window-action="close"]')?.addEventListener('click', (event) => {
      event.stopPropagation();
      closeWindow(state);
    });

    taskButton?.addEventListener('click', () => {
      if (state.closed || state.minimized) return restoreWindow(state);
      if (state.element.classList.contains('window-active')) return minimizeWindow(state);
      setActive(state);
    });
  });

  const media = windowStates.get('media');
  const chat = windowStates.get('chat');
  if (chat) setActive(chat);
  if (media) setActive(media);
}

function iconPositionKey(id) { return `watchTogether.desktopIcon.${id}`; }

function loadIconPosition(id) {
  if (!config.display?.rememberDesktopIcons) return null;
  const value = readJson(iconPositionKey(id));
  if (!value || !Number.isFinite(value.x) || !Number.isFinite(value.y)) return null;
  return value;
}

function saveIconPosition(id, x, y) {
  if (!config.display?.rememberDesktopIcons) return;
  writeJson(iconPositionKey(id), { x, y });
}

function placeIconDefault(element, item) {
  const stored = loadIconPosition(item.id);
  const { width, workHeight } = desktopBounds();
  if (stored) {
    element.style.left = `${clamp(stored.x, 0, Math.max(0, width - 74))}px`;
    element.style.top = `${clamp(stored.y, 0, Math.max(0, workHeight - 72))}px`;
    return;
  }
  if (item.anchor === 'bottom-right') {
    element.style.left = `${Math.max(4, width - 78)}px`;
    element.style.top = `${Math.max(4, workHeight - 80)}px`;
  } else {
    element.style.left = `${item.x ?? 12}px`;
    element.style.top = `${item.y ?? 12}px`;
  }
}

function deselectIcons(except = null) {
  iconHost?.querySelectorAll('.desktop-icon.selected').forEach((element) => {
    if (element !== except) element.classList.remove('selected');
  });
}

function initDesktopIcons() {
  if (!iconHost) return;
  for (const item of config.desktopIcons || []) {
    const icon = document.createElement('div');
    icon.className = 'desktop-icon';
    icon.dataset.iconId = item.id;
    icon.tabIndex = 0;
    icon.title = item.label;

    const image = document.createElement('img');
    image.src = item.icon;
    image.alt = '';
    image.draggable = false;
    if (item.fallback) image.addEventListener('error', () => { image.src = item.fallback; }, { once: true });
    const label = document.createElement('span');
    label.textContent = item.label;
    icon.append(image, label);
    iconHost.append(icon);
    placeIconDefault(icon, item);

    let drag = null;
    icon.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      deselectIcons(icon);
      icon.classList.add('selected');
      icon.setPointerCapture(event.pointerId);
      const point = clientToDesktop(event.clientX, event.clientY);
      drag = {
        pointerId: event.pointerId,
        dx: point.x - (Number.parseFloat(icon.style.left) || 0),
        dy: point.y - (Number.parseFloat(icon.style.top) || 0),
        moved: false,
      };
      icon.classList.add('dragging');
      event.preventDefault();
    });
    icon.addEventListener('pointermove', (event) => {
      if (!drag || event.pointerId !== drag.pointerId) return;
      const point = clientToDesktop(event.clientX, event.clientY);
      const { width, workHeight } = desktopBounds();
      const x = clamp(point.x - drag.dx, 0, Math.max(0, width - icon.offsetWidth));
      const y = clamp(point.y - drag.dy, 0, Math.max(0, workHeight - icon.offsetHeight));
      drag.moved ||= Math.abs(x - (Number.parseFloat(icon.style.left) || 0)) > 1 || Math.abs(y - (Number.parseFloat(icon.style.top) || 0)) > 1;
      icon.style.left = `${Math.round(x)}px`;
      icon.style.top = `${Math.round(y)}px`;
    });
    const finish = (event) => {
      if (!drag || event.pointerId !== drag.pointerId) return;
      saveIconPosition(item.id, Number.parseFloat(icon.style.left) || 0, Number.parseFloat(icon.style.top) || 0);
      icon.classList.remove('dragging');
      drag = null;
    };
    icon.addEventListener('pointerup', finish);
    icon.addEventListener('pointercancel', finish);

    const openTarget = () => { if (item.openWindow) openWindow(item.openWindow); };
    icon.addEventListener('dblclick', openTarget);
    icon.addEventListener('keydown', (event) => {
      if ((event.key === 'Enter' || event.key === ' ') && item.openWindow) {
        event.preventDefault();
        openTarget();
      }
    });
  }

  document.addEventListener('pointerdown', (event) => {
    if (!event.target.closest('.desktop-icon')) deselectIcons();
  });
}

function clampEverythingToDesktop() {
  for (const state of windowStates.values()) {
    if (state.maximized) maximizeWindow(state, true);
    else applyRect(state, state.rect);
  }
  if (!iconHost) return;
  const { width, workHeight } = desktopBounds();
  iconHost.querySelectorAll('.desktop-icon').forEach((element) => {
    const x = clamp(Number.parseFloat(element.style.left) || 0, 0, Math.max(0, width - element.offsetWidth));
    const y = clamp(Number.parseFloat(element.style.top) || 0, 0, Math.max(0, workHeight - element.offsetHeight));
    element.style.left = `${Math.round(x)}px`;
    element.style.top = `${Math.round(y)}px`;
  });
}

maybeResetSavedLayout();
installConfiguredFonts();
if (desktop && workspace && taskbar) {
  applyDesktopScale();
  initWindows();
  initDesktopIcons();

  window.addEventListener('resize', () => {
    applyDesktopScale();
    clampEverythingToDesktop();
  });
}

window.WT_WINDOWS = {
  open: openWindow,
  minimize: (id) => minimizeWindow(windowStates.get(id)),
  maximize: (id) => maximizeWindow(windowStates.get(id)),
  restore: (id) => restoreWindow(windowStates.get(id)),
  close: (id) => closeWindow(windowStates.get(id)),
  getScale: () => uiScale,
};
