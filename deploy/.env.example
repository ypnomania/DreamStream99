# Shared HMAC secret. Generate locally with: openssl rand -base64 48
MEDIA_GRANT_SECRET=replace-me

ALLOWED_ORIGIN=https://ypnomania.github.io
PUBLIC_HOST=dreamstream99.lucius7.dev
# Production loads the private Hong Kong VLESS media-egress sidecar overlay.
COMPOSE_FILE=docker-compose.yml:deploy/compose.media-egress.yml
# Compose always binds these ports to 127.0.0.1 so Node/FastAPI cannot be
# exposed accidentally. Change only the local port number when necessary.
CONTROL_PORT=8787
MEDIA_PORT=8788
MAX_ROOMS=10000

# Optional yt-dlp anti-bot inputs. Enable both paths together only after
# following docs/YOUTUBE_COOKIES.md. Mount the read-only source at
# /run/secrets/youtube.cookies.txt; startup stages a private tmpfs base and each
# cache-miss yt-dlp extraction gives its one-shot subprocess a disposable copy.
YTDLP_COOKIEFILE_SOURCE=
YTDLP_COOKIEFILE=
YTDLP_PLAYER_CLIENT=web_embedded
YTDLP_PLUGIN_PACKAGE=bgutil-ytdlp-pot-provider==1.3.1
YTDLP_PO_TOKEN_PROVIDER=youtubepot-bgutilhttp:base_url=http://pot-provider:4416
# Install the reviewed single-node VLESS Reality configuration at
# deploy/secrets/egress/media-egress.yaml. Keep every live node parameter in
# that ignored file; never put a server, UUID, key, or short ID in this file.
# With deploy/compose.media-egress.yml, keep this private Docker-network URL.
# For an external proxy, use one protected HTTP(S) URI instead. Never commit credentials.
MEDIA_EGRESS_PROXY=http://media-egress:7890
# Deprecated compatibility alias; leave empty when MEDIA_EGRESS_PROXY is set.
YTDLP_PROXY=
YTDLP_SOCKET_TIMEOUT=20

# Bound expensive yt-dlp extraction on small VPS instances. Concurrent requests
# for the same MediaRef share one extraction; successful results are cached
# briefly in an LRU so host and guest joins do not repeat the same work.
MEDIA_RESOLVE_CACHE_TTL_SECONDS=300
MEDIA_RESOLVE_MAX_CACHE_ENTRIES=128
MEDIA_RESOLVE_MAX_CONCURRENT=1
MEDIA_RESOLVE_MAX_PENDING=8
MEDIA_RESOLVE_TIMEOUT_SECONDS=45

RELAY_REFRESH_TIMEOUT_SECONDS=50
RELAY_REFRESH_FAILURE_COOLDOWN_SECONDS=5
RELAY_MAX_CONCURRENT_REFRESHES=4
